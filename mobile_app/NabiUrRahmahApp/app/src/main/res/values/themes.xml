<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NabiUrRahmah" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nur_background</item>
        <item name="android:colorAccent">@color/nur_primary</item>
    </style>

    <style name="Theme.NabiUrRahmah.Starting" parent="Theme.SplashScreen">
        <!-- Same colour as the Durood screen that follows, so the two read as one. -->
        <item name="windowSplashScreenBackground">@color/nur_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.NabiUrRahmah</item>
    </style>
</resources>
